---
import HealthReport from './HealthReport.astro';
import BackupSnapshots from './BackupSnapshots.astro';
import UniversalList from './UniversalList.astro';
import AdminAdvanced from './AdminAdvanced.astro';
import AdminTools from './AdminTools.astro';
import AdminBase from '../../layouts/AdminBase.astro';
import { permitted } from '../../lib/admin/access';
import type { AdminIdentity, AdminModule } from '../../lib/admin/access';
import type { AdminData } from '../../lib/admin/data';
import { adMap } from '../../lib/ads';
import { dhakaInput, settingsFields } from '../../lib/admin/actions';
interface Props { module: AdminModule; actor?: AdminIdentity; data?: AdminData; error?: string; message?: string; jobUrl?: string; platformAds?: boolean; secrets?: Array<{ name: string; set: boolean }>; submitted?: URLSearchParams; }
const { module, actor, data, error, message, jobUrl, platformAds = false, secrets = [], submitted } = Astro.props;
const modules = { dashboard: 'Dashboard', links: 'Links & Offers', ads: 'Ads', content: 'Show / Hide', pages: 'Info Pages', sync: 'Sync', settings: 'Settings', backup: 'Backup', seo: 'SEO', changes: 'History', titles: 'Edit Titles', people: 'Edit People', tools: 'Tools' } as const;
const formatNames: Record<number, string> = { 32197577: 'Top banner · 300×250', 32197602: 'Sticky banner · 320×50', 32197641: 'Native ads', 32197642: 'Popunder', 32197643: 'Social Bar' };
const heading = modules[module as keyof typeof modules] || 'Admin';
const canWrite = actor && permitted(actor, module, true);
const link = data?.selectedLink;
const values = (name: string, fallback: unknown = '') => submitted?.get(name) ?? String(fallback ?? '');
let rules: { byCountry?: Record<string, string>; byDevice?: Record<string, string> } = {};
try { rules = JSON.parse(link?.rules || '{}'); } catch { /* Empty editor for malformed legacy rules. */ }
const settingValue = (key: string) => data?.settings.find(setting => setting.key === key);
const date = (value: string) => Number.isFinite(Date.parse(value)) ? new Intl.DateTimeFormat('en', { timeZone: 'Asia/Dhaka', dateStyle: 'medium', timeStyle: 'short' }).format(new Date(value.endsWith('Z') || value.includes('+') ? value : `${value.replace(' ', 'T')}Z`)) : value;
const pageNames: Record<string, string> = { home: 'Home page', list: 'List pages — Movies, Series, Genres', detail: 'Movie & show pages', cast: 'Cast pages', watch: 'Where to Watch pages', trailer: 'Trailer pages', search: 'Search results', global: 'Every page' };
const placementNames: Record<string, string> = { top_300x250: 'Top banner · 300×250', native: 'Native ads', infeed: 'In-feed banner · 300×250', sticky_320x50: 'Sticky bottom banner · 320×50', popunder: 'Popunder', social_bar: 'Social Bar' };
const pageLink = (page: number) => { const query = new URLSearchParams(Astro.url.searchParams); query.set('page', String(page)); return `${Astro.url.pathname}?${query}`; };
const revenueTrendMax = Math.max(...(data?.revenue?.trend.map(day => day.revenue) ?? []), 0.01);
const revenueToday = data?.revenue?.trend.find(day => day.date === new Date().toISOString().slice(0, 10)) ?? null;
const payoutPct = data?.revenue ? Math.min(100, Math.round((data.revenue.balanceEstimate / data.revenue.payoutMin) * 100)) : 0;
---
<AdminBase title={heading}>
  <div class="admin-heading"><div><p class="eyebrow">SCREENPEEK ADMIN</p><h1>{heading}</h1></div>{actor && <p>{actor.email}<br /><strong>{actor.role}</strong></p>}</div>
  {actor && <nav class="admin-nav" aria-label="Admin modules">{Object.entries(modules).filter(([key]) => permitted(actor, key as AdminModule)).map(([key, label]) => <a href={`/admin/${key === 'dashboard' ? '' : `${key}/`}`} aria-current={module === key ? 'page' : undefined}>{label}</a>)}</nav>}
  {actor && <nav class="admin-tabbar" aria-label="Quick navigation">{permitted(actor, 'dashboard') && <a class="admin-tab" href="/admin/" aria-current={module === 'dashboard' ? 'page' : undefined}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg><span>Home</span></a>}{permitted(actor, 'content') && <a class="admin-tab" href="/admin/content/" aria-current={module === 'content' ? 'page' : undefined}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18"/><path d="M3 7.5h4"/><path d="M3 12h18"/><path d="M3 16.5h4"/><path d="M17 3v18"/><path d="M17 7.5h4"/><path d="M17 16.5h4"/></svg><span>Content</span></a>}{permitted(actor, 'ads') && <a class="admin-tab" href="/admin/ads/" aria-current={module === 'ads' ? 'page' : undefined}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg><span>Ads</span></a>}{permitted(actor, 'links') && <a class="admin-tab" href="/admin/links/" aria-current={module === 'links' ? 'page' : undefined}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg><span>Links</span></a>}<button class="admin-tab" type="button" data-more-open aria-expanded="false" aria-controls="admin-more-sheet" data-active={!['dashboard', 'content', 'ads', 'links'].includes(module) ? 'true' : undefined}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="5" cy="12" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/></svg><span>More</span></button></nav>}
  {actor && <div class="admin-sheet-scrim" data-more-scrim hidden></div>}
  {actor && <div class="admin-sheet" id="admin-more-sheet" role="dialog" aria-label="All admin modules" hidden><div class="admin-sheet-head"><strong>All sections</strong><button type="button" data-more-close>Close</button></div><nav class="admin-sheet-nav" aria-label="All admin modules">{Object.entries(modules).filter(([key]) => permitted(actor, key as AdminModule)).map(([key, label]) => <a href={`/admin/${key === 'dashboard' ? '' : `${key}/`}`} aria-current={module === key ? 'page' : undefined}>{label}</a>)}</nav></div>}
  {actor && <script>const adminSheet = document.getElementById('admin-more-sheet'); const adminScrim = document.querySelector('[data-more-scrim]'); const adminMoreOpen = document.querySelector('[data-more-open]'); const adminMoreClose = document.querySelector('[data-more-close]'); const openAdminSheet = () => { adminSheet?.removeAttribute('hidden'); adminScrim?.removeAttribute('hidden'); adminMoreOpen?.setAttribute('aria-expanded', 'true'); }; const closeAdminSheet = () => { adminSheet?.setAttribute('hidden', ''); adminScrim?.setAttribute('hidden', ''); adminMoreOpen?.setAttribute('aria-expanded', 'false'); }; const toggleAdminSheet = () => { if (adminSheet && adminSheet.hasAttribute('hidden')) openAdminSheet(); else closeAdminSheet(); }; adminMoreOpen?.addEventListener('click', toggleAdminSheet); adminMoreClose?.addEventListener('click', closeAdminSheet); adminScrim?.addEventListener('click', closeAdminSheet); document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeAdminSheet(); });</script>}
  {actor && <script>const counters = document.querySelectorAll('[data-countup]'); if (counters.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) { const t0 = performance.now(); const tick = () => { const t = Math.min(1, (performance.now() - t0) / 900); counters.forEach((el) => { el.textContent = '$' + (Number(el.getAttribute('data-countup') || 0) * t).toFixed(2); }); if (t < 1) requestAnimationFrame(tick); }; requestAnimationFrame(tick); }</script>}
  {error && <p class="notice admin-error" role="alert">{error}</p>}
  {message && <p class="notice" role="status">{message}{jobUrl && <> <a href={jobUrl} rel="noreferrer">Check the workflow <svg class="link-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a></>}</p>}
  {actor && data && <>
    {!error && ['links','ads','content','pages','sync','seo','changes','titles','people'].includes(module) && <UniversalList actor={actor} module={module} />}
    {['seo','changes'].includes(module) && <AdminAdvanced module={module} actor={actor} />}
    {module === 'tools' && <AdminTools actor={actor} data={data} />}
    {module === 'dashboard' && <><HealthReport actor={actor} />
      <section class="catalogue-section"><h2>Revenue — Adsterra</h2>{data.revenue ? <><div class="widget-grid"><div class="revenue-hero widget"><h2><svg class="widget-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"/><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"/><path d="M18 12a2 2 0 0 0 0 4h4v-4Z"/></svg>Balance (estimate)</h2><p class="revenue-hero-figure" data-countup={data.revenue.balanceEstimate}>${data.revenue.balanceEstimate.toFixed(2)}</p><small>Estimate only: all-time earnings minus the payouts Adsterra's pay calendar says should already have been made. Adsterra's own Payouts page holds the exact figure — their API has no balance feed.</small></div><section class="widget ring-widget"><h2><svg class="widget-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>Payout progress</h2><div class="ring-wrap"><svg class="ring" viewBox="0 0 120 120" aria-hidden="true"><circle class="ring-track" cx="60" cy="60" r="52"/><circle class="ring-prog" cx="60" cy="60" r="52" style={`stroke-dashoffset:${(326.73 * (1 - payoutPct / 100)).toFixed(1)}`}/></svg><div class="ring-centre"><strong>{payoutPct}%</strong><small>${data.revenue.balanceEstimate.toFixed(2)} of ${data.revenue.payoutMin.toFixed(0)}</small></div></div><small>{data.revenue.balanceEstimate >= data.revenue.payoutMin ? 'Payout minimum reached — the next scheduled payout should include this balance.' : `$${(data.revenue.payoutMin - data.revenue.balanceEstimate).toFixed(2)} more to reach the $${data.revenue.payoutMin.toFixed(0)} payout minimum.`}</small></section><section class="widget"><h2><svg class="widget-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>Yesterday</h2>{data.revenue.yesterday ? <><p class="admin-big" data-countup={data.revenue.yesterday.revenue}>${data.revenue.yesterday.revenue.toFixed(2)}</p><small>{data.revenue.yesterday.impressions.toLocaleString()} impressions · {data.revenue.yesterday.clicks} clicks · CPM ${data.revenue.yesterday.cpm.toFixed(2)} · day {data.revenue.yesterday.date} (UTC)</small></> : <p>No data for yesterday yet.</p>}</section>{revenueToday && <section class="widget"><h2><svg class="widget-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>Today's revenue</h2><p class="admin-big" data-countup={revenueToday.revenue}>${revenueToday.revenue.toFixed(2)}</p><small>{revenueToday.impressions.toLocaleString()} impressions · {revenueToday.clicks} clicks so far today (UTC)</small></section>}<section class="widget"><h2><svg class="widget-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>This month</h2><p class="admin-big" data-countup={data.revenue.monthRevenue}>${data.revenue.monthRevenue.toFixed(2)}</p><small>{data.revenue.monthImpressions.toLocaleString()} impressions so far</small></section><section class="widget"><h2><svg class="widget-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="12" x="2" y="6" rx="2"/><circle cx="12" cy="12" r="2"/><path d="M6 12h.01M18 12h.01"/></svg>Earned all time</h2><p class="admin-big" data-countup={data.revenue.allTime}>${data.revenue.allTime.toFixed(2)}</p><small>Everything Adsterra reports for ScreenPeek</small></section></div>{data.revenue.trend.length > 1 && <div class="revenue-trend-wrap"><h3>Last 7 days</h3><div class="revenue-trend" role="img" aria-label="Daily revenue for the last 7 days">{data.revenue.trend.map(d => <div class="revenue-bar"><span class="bar-track"><span class="bar-fill" style={`height:${Math.max(4, Math.round((d.revenue / revenueTrendMax) * 100))}%`} title={`${d.date}: $${d.revenue.toFixed(2)}`}></span></span><small>{d.date.slice(5)}</small></div>)}</div></div>}{data.revenue.formats.length > 0 && <><h3>Where the money comes from</h3><ul>{data.revenue.formats.map(f => <li>{formatNames[f.placement_id] || `Placement ${f.placement_id}`} — ${f.revenue.toFixed(2)} · {f.impressions.toLocaleString()} impressions</li>)}</ul></>}<small>Figures are pulled from Adsterra automatically every 30 minutes{data.revenue.updatedAt ? ` · last update ${data.revenue.updatedAt} UTC` : ''}. Milestone and payout alerts go to @TrafeeUpdatebot on Telegram.</small></> : <p>Revenue tracking is on — the automatic checker fills this in within about 30 minutes of the first check.</p>}</section>
      <div class="admin-meters"><section><h2><svg class="widget-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16 6 4 14"/><path d="M12 6v14"/><path d="M8 8v12"/><path d="M4 4v16"/></svg>Your library</h2><p><strong>{data.catalogue?.titles.toLocaleString() || 0}</strong> titles</p><p>{data.catalogue?.people.toLocaleString() || 0} people · {data.catalogue?.gated.toLocaleString() || 0} ready for search engines</p></section><section><h2><svg class="widget-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3l7.07 16.97 2.51-7.39 7.39-2.51L3 3z"/><path d="M13 13l6 6"/></svg>Link clicks today</h2><p class="admin-big">≈ {data.catalogue?.clicks.toLocaleString() || 0}</p><small>Approximate — counted on a UTC day</small></section><section><h2><svg class="widget-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/></svg>Last sync</h2><p>{data.sync[0]?.status || 'No sync recorded'}</p>{data.sync[0] && <small>{date(data.sync[0].started_at)} · Bangladesh time</small>}</section><section><h2><svg class="widget-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>Publishing</h2><p>{data.pending ? `${data.pending} saved changes are still going live.` : 'All saved changes are live.'}</p><p>Ad revenue is tracked in the Revenue section above.</p><a href="https://dash.cloudflare.com/" rel="noreferrer">See today's Cloudflare usage <svg class="link-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a></section></div>
      <section class="catalogue-section"><h2>Recent changes</h2>{data.changes.length ? <div class="admin-table"><table><thead><tr><th>When (Bangladesh)</th><th>Actor</th><th>Change</th></tr></thead><tbody>{data.changes.map(row => <tr><td>{date(row.ts)}</td><td>{row.actor || 'Not recorded'}</td><td>{row.entity} · {row.entity_id}</td></tr>)}</tbody></table></div> : <p class="quiet-empty">No admin changes yet.</p>}</section>
      <AdminAdvanced module={module} actor={actor} />
    </>}
    {(module === 'links' || module === 'content') && <form class="admin-search" method="get"><label>Search {module === 'links' ? 'links' : 'titles'}<input name="q" value={data.query} maxlength="100" /></label><button type="submit">Search</button><a href={Astro.url.pathname}>Clear</a></form>}
    {module === 'links' && <>
      <p class="notice">When a visitor clicks one of these links: a country destination wins first, then a device one — otherwise the default destination is used. Click counts are approximate.</p>
      <div class="admin-table"><table><thead><tr><th>Name / slug</th><th>Type</th><th>State</th><th>Approx. clicks</th><th>Edit</th></tr></thead><tbody>{data.links.map(row => <tr><td>{row.name}<small>/go/{row.slug}/</small></td><td>{row.type}</td><td>{row.enabled ? 'On' : 'Off'}</td><td>≈ {row.clicks_total.toLocaleString()}</td><td><a href={`?edit=${encodeURIComponent(row.slug)}`}>Open</a></td></tr>)}</tbody></table></div>
      <section class="catalogue-section"><h2>{link ? `Edit ${link.name}` : 'Add link'}</h2>{link && <a href="/admin/links/">Add a different link</a>}
      <form class="admin-form" method="post"><input type="hidden" name="original_slug" value={link?.slug || ''} /><input type="hidden" name="revision" value={link?.revision ?? -1} />
        <fieldset disabled={!canWrite}><label>Name *<input name="name" value={values('name', link?.name)} required maxlength="200" /></label>
        <label>Slug *<input name="slug" value={values('slug', link?.slug)} required pattern="[a-z0-9]+(-[a-z0-9]+)*" maxlength="120" readonly={!!link?.clicks_total} aria-describedby="link-slug-help" /></label><small id="link-slug-help">Lowercase words and hyphens. Locked after recorded clicks.</small>
        <label>Type *<select name="type">{['affiliate', 'smartlink', 'social', 'other'].map(type => <option value={type} selected={values('type', link?.type || 'affiliate') === type}>{type}</option>)}</select></label>
        <label>Default destination *<input name="destination" type="url" value={values('destination', link?.destination)} required maxlength="2048" placeholder="https://" /></label>
        {['US', 'GB', 'CA', 'AU'].map(country => <label>{country} destination<input type="url" name={`country_${country}`} value={values(`country_${country}`, rules?.byCountry?.[country])} maxlength="2048" placeholder="Optional HTTPS URL" /></label>)}
        {['mobile', 'desktop'].map(device => <label>{device} destination<input type="url" name={`device_${device}`} value={values(`device_${device}`, rules?.byDevice?.[device])} maxlength="2048" placeholder="Optional HTTPS URL" /></label>)}
        <label class="admin-check"><input name="enabled" type="checkbox" value="1" checked={submitted ? submitted.has('enabled') : link ? !!link.enabled : true} /> Enabled</label>
        <label>Start (Bangladesh time)<input name="starts_at" type="datetime-local" value={values('starts_at', dhakaInput(link?.starts_at))} /></label><label>End (Bangladesh time)<input name="ends_at" type="datetime-local" value={values('ends_at', dhakaInput(link?.ends_at))} /></label>
        <p class="admin-help">After you save, the change goes live within a few minutes.</p><button class="primary" type="submit">Save link</button></fieldset>
      </form></section>
    </>}
    {module === 'ads' && <>
      <p class="notice">{platformAds ? 'Ads are switched ON for the whole site. The master switch below can pause everything at once.' : 'This deployment has ads locked OFF at the platform level, so saved codes only show as placeholders. The platform ads flag must be enabled before any code can run.'}</p>
      <div class="admin-settings">{(['ads_enabled', 'popunder_cap_hours','ads_display_enabled','ads_native_enabled','ads_sticky_enabled','ads_social_enabled','ads_popunder_enabled','ads_txt'] as const).map(key => <form class="admin-form" method="post"><input type="hidden" name="key" value={key} /><input type="hidden" name="revision" value={settingValue(key)?.revision ?? -1} /><fieldset disabled={!canWrite}><label>{settingsFields[key]}{key === 'ads_txt' ? <textarea name="value" rows="8" maxlength="20000">{settingValue(key)?.value || ''}</textarea> : <input name="value" value={settingValue(key)?.value ?? (key === 'popunder_cap_hours' ? '24' : key === 'ads_enabled' ? '0' : '1')} />}</label>{key !== 'ads_txt' && key !== 'popunder_cap_hours' && <span class={`state-pill ${(settingValue(key)?.value ?? (key === 'ads_enabled' ? '0' : '1')) === '1' ? 'on' : 'off'}`}>{(settingValue(key)?.value ?? (key === 'ads_enabled' ? '0' : '1')) === '1' ? 'Now: ON' : 'Now: OFF'}</span>}<small>{key === 'popunder_cap_hours' ? 'How many hours to wait before the same visitor can see another popunder. 24 = once a day.' : key === 'ads_txt' ? 'Plain text, shown publicly at /ads.txt — ad networks read it to verify this site is yours.' : 'Type 1 for ON or 0 for OFF, then Save. The platform switch and the master switch must both be ON for ads to run.'}</small><button type="submit">Save {settingsFields[key].toLowerCase()}</button></fieldset></form>)}</div>
      <p>Each card below is one ad slot on the site: paste the code, tick Enabled, Save. Adsterra gives one code per ad size, so same-size slots share a code — that is normal. A slot in test mode shows its code only to a signed-in admin who opens the page with <code>?adtest=1</code>.</p>
      <div class="admin-slot-board">{Object.entries(adMap).flatMap(([page, placements]) => placements.map(placement => {
        const row = data.slots.find(slot => slot.page_type === page && slot.placement === placement);
        const duplicates = row?.code.trim() ? data.slots.filter(other => other.code.trim() === row.code.trim() && (other.page_type !== page || other.placement !== placement)) : [];
        return <section class="admin-slot" id={`slot-${page}-${placement}`}><h2>{page} / {placement}</h2><p class="slot-tech">{pageNames[page] || page} — {placementNames[placement] || placement} · Adsterra placement name: {page}_{placement}</p><p class={`eyebrow slot-state-${row?.code.trim() ? (row.enabled ? 'on' : 'off') : 'empty'}`}><span class="state-dot" aria-hidden="true"></span>{row?.code.trim() ? row.enabled ? 'ON — code saved' : 'OFF — code saved' : 'EMPTY — no code yet'}</p>{duplicates.length > 0 && <p class="notice admin-note-info">Duplicate code also used in {duplicates.map(slot => `${slot.page_type}/${slot.placement}`).join(', ')}. This is normal with Adsterra: it gives one code per ad size, so same-size slots share it. Earnings stay correct — Adsterra simply reports those slots together.</p>}
          <form class="admin-form" method="post"><input type="hidden" name="page_type" value={page} /><input type="hidden" name="placement" value={placement} /><input type="hidden" name="revision" value={row?.revision ?? -1} /><fieldset disabled={!canWrite}>
            <label>Original code<textarea name="code" rows="5" maxlength="65536" spellcheck="false">{submitted?.get('page_type') === page && submitted?.get('placement') === placement ? submitted.get('code') : row?.code || ''}</textarea><small>Paste the full code from Adsterra exactly as given. It is saved word-for-word, never edited.</small></label>
            <label class="admin-check"><input type="checkbox" name="enabled" value="1" checked={!!row?.enabled} /> Enabled</label><label class="admin-check"><input type="checkbox" name="test_mode" value="1" checked={!!row?.test_mode} /> Authenticated test mode</label>
            <label>Start (Bangladesh time)<input name="starts_at" type="datetime-local" value={dhakaInput(row?.starts_at)} /></label><label>End (Bangladesh time)<input name="ends_at" type="datetime-local" value={dhakaInput(row?.ends_at)} /></label>
            <small>Start and end are optional — leave empty to run all the time. On pre-built pages, code and schedule changes appear after the next build (nightly).</small><button type="submit">Save {page}/{placement}</button>
          </fieldset></form>
        </section>;
      }))}</div>
    </>}
    {module === 'content' && <><p>Pin a title to push it up on the homepage, or hide it from the public site. You can undo both here at any time.</p><div class="admin-content">{data.titles.map(title => <form class="admin-form admin-title-row" method="post"><h2><a href={`/${title.type === 'movie' ? 'movie' : 'tv'}/${title.slug}/`}>{title.title}</a></h2><input type="hidden" name="id" value={title.id} /><input type="hidden" name="type" value={title.type} /><input type="hidden" name="revision" value={title.revision} /><fieldset disabled={!canWrite}><label class="admin-check"><input type="checkbox" name="pinned" value="1" checked={!!title.pinned} /> Pinned</label><label class="admin-check"><input type="checkbox" name="hidden" value="1" checked={!!title.hidden} /> Hidden</label><button type="submit">Save title visibility</button></fieldset></form>)}</div></>}
    {module === 'sync' && <><p>New movies and shows are added automatically every day at 2:30 pm Bangladesh time. Visitors are always served from your own catalogue — nobody's visit calls TMDb.</p>{canWrite && <form method="post"><input type="hidden" name="action" value="run-sync" /><button class="primary" type="submit">Run sync now</button></form>}<p>The run happens on GitHub. When it starts, a link to watch it appears at the top of this page.</p><div class="admin-table"><table><thead><tr><th>Started (Bangladesh)</th><th>Status</th><th>Added / updated</th><th>Errors</th></tr></thead><tbody>{data.sync.map(row => <tr><td>{date(row.started_at)}</td><td>{row.status}</td><td>{row.added} / {row.updated}</td><td><details><summary>Details</summary><pre>{row.errors || 'No errors recorded'}</pre></details></td></tr>)}</tbody></table></div>{data.sync.length === 0 && <p class="quiet-empty">No sync runs recorded.</p>}</>}
    {module === 'settings' && <><p>Site-wide switches and text settings. Passwords and API keys never live here — they are kept in secure environment settings and are never shown.</p><div class="admin-settings">{Object.entries(settingsFields).map(([key, label]) => {
      const setting = settingValue(key);
      return <form class="admin-form" method="post"><input type="hidden" name="key" value={key} /><input type="hidden" name="revision" value={setting?.revision ?? -1} /><fieldset disabled={!canWrite}><label>{label}<input name="value" value={submitted?.get('key') === key ? submitted.get('value') || '' : setting?.value || (key === 'site_name' ? 'ScreenPeek' : '')} maxlength="250" aria-describedby={`setting-help-${key}`} /></label>{['ads_enabled', 'maintenance', 'ratings_external', 'ads_display_enabled', 'ads_native_enabled', 'ads_sticky_enabled', 'ads_social_enabled', 'ads_popunder_enabled'].includes(key) && (setting?.value === '0' || setting?.value === '1') && <span class={`state-pill ${setting?.value === '1' ? 'on' : 'off'}`}>{setting?.value === '1' ? 'Now: ON' : 'Now: OFF'}</span>}<small id={`setting-help-${key}`}>{['ads_enabled', 'maintenance', 'ratings_external', 'ads_display_enabled', 'ads_native_enabled', 'ads_sticky_enabled', 'ads_social_enabled', 'ads_popunder_enabled'].includes(key) ? 'Type 1 for ON or 0 for OFF, then Save.' : key === 'popunder_cap_hours' ? 'Hours to wait before the same visitor sees another popunder. From 1 to 168; 24 = once a day.' : key === 'sync_max_titles' ? 'Most titles one nightly sync may add or update. From 1 to 2000.' : key === 'cache_ttl_list' || key === 'cache_ttl_detail' ? 'How long, in seconds, a page is reused before it is rebuilt. Server-rendered pages only; pre-built pages refresh on the nightly build.' : 'Pre-built pages pick up the change on the next build (nightly).'}</small><button type="submit">Save {label.toLowerCase()}</button></fieldset></form>;
    })}</div><section class="catalogue-section"><h2>System connections</h2><dl class="title-facts">{secrets.map(secret => <div><dt>{secret.name}</dt><dd>{secret.set ? <><svg class="set-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Set</> : 'Not set'}</dd></div>)}</dl><p>Sync and backup keys live in GitHub Actions instead — this page cannot see those.</p></section></>}
    {module==='backup' && <BackupSnapshots />}
    {module === 'backup' && <section class="empty-state"><h2>Export site configuration</h2><p>This file contains your ad codes and link destinations — keep it private. It holds settings and content overrides only, not the movie catalogue or poster files.</p><a class="button primary" href="?download=1">Download configuration JSON</a><form class="admin-form" method="post" enctype="multipart/form-data"><label>Configuration export<input type="file" name="backup_file" accept="application/json,.json" required /></label><label>Type RESTORE to replace configuration<input name="confirm_restore" required pattern="RESTORE" /></label><p>A private pre-restore snapshot must succeed before any configuration is replaced.</p><button>Restore configuration</button></form></section>}
    {module === 'pages' && <>
      <nav class="hub-navigation" aria-label="Information pages">{data.documents.map(document => <a href={`?edit=${document.slug}`}>{document.title}</a>)}</nav>
      {data.documents.filter(document => document.slug === (Astro.url.searchParams.get('edit') || 'about')).map(document => <section class="catalogue-section"><h2>Edit {document.title}</h2><form class="admin-form" method="post"><input type="hidden" name="slug" value={document.slug} /><input type="hidden" name="revision" value={document.revision} /><fieldset disabled={!canWrite}>
        <label>Page title *<input name="title" value={submitted?.get('slug') === document.slug ? submitted.get('title') : document.title} maxlength="120" required /></label>
        <label>Page content (Markdown) *<textarea name="body_md" rows="18" maxlength="20000" required>{submitted?.get('slug') === document.slug ? submitted.get('body_md') : document.body_md}</textarea></label><small>Write with Markdown: headings, lists, bold and links work; raw HTML and images inside the text do not show. These pages refresh on the next build (nightly), and the TMDb credit line always stays.</small>
        <button class="primary" type="submit">Save page</button>
      </fieldset></form><a href={document.slug === '404' ? '/404/' : `/${document.slug}/`}>Open public page <svg class="link-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a></section>)}
    </>}
    {(module === 'links' || module === 'content') && data.pages > 1 && <nav class="pagination" aria-label="Admin pages">{data.page > 1 && <a href={pageLink(data.page - 1)}>Previous</a>}<span>Page {data.page} of {data.pages}</span>{data.page < data.pages && <a href={pageLink(data.page + 1)}>Next</a>}</nav>}
  </>}
</AdminBase>
