---
import { titleOriginality } from '../lib/originality';
import Base from '../layouts/Base.astro';
import AdSlot from './AdSlot.astro';
import AdStack from './AdStack.astro';
import PosterCard from './PosterCard.astro';
import RatingStrip from './RatingStrip.astro';
import VerdictWidget from './VerdictWidget.astro';
import { parseJsonArray } from '../lib/detail';
import type { TitlePageData } from '../lib/detail';
import { mediaUrl } from '../lib/media';
import { readLink, linkActive } from '../lib/links';
import { siteOrigin, titleSchema } from '../lib/seo';
import { env } from 'cloudflare:workers';
interface Props { data: TitlePageData; mediaBase?: string; }
const { data, mediaBase } = Astro.props;
const { title } = data;
const originality = titleOriginality(data);
const available = data.status === 200 && title !== null;
const kind = title?.type === 'tv' ? 'TV series' : 'Movie';
const indexUrl = title?.type === 'tv' ? '/series/' : '/movies/';
const watchUrl = `/watch/${encodeURIComponent(title?.slug || '')}/`;
const trailerUrl = `/trailer/${encodeURIComponent(title?.slug || '')}/`;
// The one designated Smartlink placement on the detail page: a clearly
// labelled Sponsored button, rendered only while the managed link is
// active in the panel (Links -> smartlink-main).
const smartlink = await readLink(env.CONFIG, env.DB, 'smartlink-main').catch(() => null);
const smartlinkActive = smartlink ? linkActive(smartlink) : false;
const poster = mediaUrl(title?.poster_r2, mediaBase, 500);
const posterSmall = mediaUrl(title?.poster_r2, mediaBase, 185);
const savedPoster = mediaUrl(title?.poster_r2, mediaBase, 185);
const backdrop = mediaUrl(title?.backdrop_r2, mediaBase);
const color = /^#[a-f\d]{6}$/i.test(title?.poster_color || '') ? title!.poster_color! : '#20202B';
const pageTitle = available ? `${title!.title}${title!.year ? ` (${title!.year})` : ''} — Cast, Trailer & Where to Watch` :
  data.status === 410 ? 'Title removed' : data.status === 503 ? 'Title unavailable' : 'Title not found';
const errorHeading = data.status === 410 ? 'This title has been removed.' : data.status === 503 ? 'Title details are temporarily unavailable.' : 'This title could not be found.';
const formatDate = (value: string | null | undefined) => {
  if (!value || !Number.isFinite(Date.parse(value))) return 'Not announced';
  return new Intl.DateTimeFormat('en', { dateStyle: 'medium', timeZone: 'UTC' }).format(new Date(value));
};
const currency = (value: number) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', notation: 'compact', maximumFractionDigits: 1 }).format(value);
const runtime = title?.runtime_min ? `${Math.floor(title.runtime_min / 60)}h ${title.runtime_min % 60}m` : null;
let language = title?.original_language || 'Not listed';
try { language = title?.original_language ? new Intl.DisplayNames(['en'], { type: 'language' }).of(title.original_language) || language : language; } catch { /* Retain the stored language code. */ }
const overview = title?.overview?.trim() || '';
const cutoff = overview.length > 480 ? Math.max(overview.lastIndexOf(' ', 480), 350) : overview.length;
const cast = data.cast.filter(person => person.role === 'cast').slice(0, 12);
const directors = data.cast.filter(person => person.role === 'director' || person.role === 'creator');
const providers = [...new Map(data.providers.map(provider => [provider.provider_id, provider])).values()];
const streamers = [...new Map(data.providers.filter(provider => ['stream', 'free', 'ads'].includes(provider.offer_type)).map(provider => [provider.provider_id, provider])).values()];
const countries: Record<string, string> = { US: 'the United States', GB: 'the United Kingdom', CA: 'Canada', AU: 'Australia' };
const country = countries[data.country] || data.country;
const gallery = parseJsonArray<string>(title?.gallery_r2).filter(key => typeof key === 'string')
  .slice(0, 6).map(key => mediaUrl(key, mediaBase)).filter((url): url is string => url !== null);
const facadeImage = gallery[0] || backdrop;
const boxOffice = title?.type === 'movie' && ((title.budget !== null && title.budget > 0) || (title.revenue !== null && title.revenue > 0));
---
<Base title={pageTitle} description={available && overview ? overview.slice(0, 155) : undefined}
  sample={data.sample} noindex={data.noindex} pageType={available ? 'detail' : 'utility'} schemas={titleSchema(data, siteOrigin(env.SITE_URL), mediaBase)}
  ogType={available ? title?.type === 'tv' ? 'video.tv_show' : 'video.movie' : 'website'} ogImage={available ? mediaUrl(title?.quality_gate ? title.og_r2 : null, mediaBase) || poster : null}>
  {!available || !title ? <section class="empty-state"><p class="eyebrow">{data.status === 503 ? 'CATALOGUE' : `${data.status} · ${data.status === 410 ? 'REMOVED' : 'NOT FOUND'}`}</p><h1>{errorHeading}</h1>
    <p>{data.status === 503 ? 'Please try again shortly.' : 'Explore the catalogue to find another movie or series.'}</p><a class="button primary" href="/">Go home</a></section> :
    <article data-title-detail data-title-record data-title-id={title.id} data-title-type={title.type} data-slug={title.slug} data-title={title.title} data-year={title.year ?? ''} data-poster={savedPoster || ''}>
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href={indexUrl}>{title.type === 'tv' ? 'Series' : 'Movies'}</a><span aria-hidden="true">/</span><span aria-current="page">{title.title}</span></nav>
      <section class="detail-hero" style={`--poster-color:${color}`} data-detail-section="poster">
        {backdrop && <div class="hero-media" aria-hidden="true"><picture><source media="(max-width: 1100px)" srcset="data:image/gif;base64,R0lGODlhAQABAIAAAP///wAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw==" /><img src={backdrop} alt="" width="300" height="169" loading="lazy" decoding="async" /></picture></div>}
        <div class="hero-shade" aria-hidden="true"></div>
        <div class="dhero-grid">
          <div class="detail-poster poster-frame">{poster ? <picture><source media="(max-width: 1100px)" srcset={posterSmall || poster} /><img src={poster} width="500" height="750" alt={`${title.title} poster`} loading="eager" fetchpriority="high" decoding="async" /></picture> :
            <div class="poster-placeholder" role="img" aria-label={`${title.title} poster unavailable`}><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 3v18M17 3v18M3 8h4m-4 8h4M17 8h4m-4 8h4"/></svg><span class="placeholder-title">{title.title}</span><span class="placeholder-label">Poster unavailable</span></div>}</div>
          <header class="detail-heading">
            <h1>{title.title}</h1>
            <p class="dhero-meta">{title.vote_average ? <span class="dhero-score"><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.6l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.5l-5.9 3.1 1.2-6.5L2.5 9.5l6.6-.9z"/></svg>{title.vote_average.toFixed(1)}</span> : null}
              {title.vote_count ? <span>{title.vote_count.toLocaleString('en-US')} votes</span> : null}
              <span>{title.year ?? 'Year TBA'}</span>{runtime && <span>{runtime}</span>}<span>{kind}</span>{title.status && <span>{title.status}</span>}</p>
            {(directors.length > 0 || cast.length > 0) && <p class="credits-line">{directors.length > 0 && <span>{title.type === 'tv' ? 'Created by' : 'Directed by'} <strong>{directors.map(person => person.name).join(', ')}</strong></span>}{directors.length > 0 && cast.length > 0 && <span aria-hidden="true"> · </span>}{cast.length > 0 && <span>Starring <strong>{cast.slice(0, 3).map(person => person.name).join(', ')}</strong></span>}</p>}
            {data.genres.length > 0 && <div class="genre-chips detail-genres" aria-label="Genres">{data.genres.map(genre => <a href={`/genre/${encodeURIComponent(genre.slug)}/`}>{genre.name}</a>)}</div>}
            <div class="detail-actions" data-detail-section="actions"><a class="button primary" href={watchUrl}>Where to Watch</a><a class="button hero-glass" href={trailerUrl}>Trailer</a>{smartlinkActive && <a class="button hero-glass" href="/go/smartlink-main/" rel="sponsored nofollow noopener" target="_blank">Watch Now <span class="ad-tag">Sponsored</span></a>}</div>
          </header>
        </div>
      </section>
      <div class="detail-cols">
        <div class="detail-main">
          <noscript><p class="control-preview">Enable JavaScript to vote.</p></noscript>
          <RatingStrip score={title.vote_average} count={title.vote_count} external={data.external} />
          <section class="catalogue-section storyline" aria-labelledby="storyline-title" data-detail-section="storyline"><h2 id="storyline-title">The Story</h2>{overview ? <><p>{overview.slice(0, cutoff)}</p>{cutoff < overview.length && <details><summary>Read more</summary><p>{overview.slice(cutoff).trim()}</p></details>}</> : <p>An overview is not available yet.</p>}</section>
          {providers.length > 0 && <section class="watch-summary" aria-label="Where to Watch summary" data-detail-section="providers"><h2>Where to Watch</h2><p>Watch options in {country}: <strong>{providers.slice(0, 3).map(provider => provider.provider_name).join(', ')}</strong>{providers.length > 3 && ` +${providers.length - 3} more`}.</p><div class="streaming-strip" aria-label="Streaming on">{streamers.length > 0 && <span>Streaming on</span>}{streamers.slice(0, 3).map(provider => {
              const logo = mediaUrl(provider.logo_r2, mediaBase, 185);
              return <a href={watchUrl} data-no-popunder>{logo && <img src={logo} width="28" height="28" loading="lazy" decoding="async" alt="" />}<span>{provider.provider_name}</span></a>;
            })}{streamers.length > 3 && <a href={watchUrl} data-no-popunder>+{streamers.length - 3} more</a>}</div><a href={watchUrl} data-no-popunder>See streaming, rent and buy options →</a><p class="provider-credit">Streaming data by JustWatch.</p></section>}
          <AdStack pageType="detail" placement="top_300x250" />
          <section class="catalogue-section" aria-labelledby="cast-title" data-detail-section="cast"><div class="section-heading"><h2 id="cast-title">Top Cast</h2></div>
            {cast.length > 0 ? <div class="cast-row">{cast.map(person => {
              const profile = mediaUrl(person.profile_r2, mediaBase, 185);
              return <a class="cast-card" href={`/cast/${encodeURIComponent(person.slug)}/`}><span class="cast-photo">{profile ? <img src={profile} width="72" height="72" loading="lazy" decoding="async" alt={`${person.name} portrait`} /> : <span class="cast-initials" aria-hidden="true">{person.name.split(/\s+/).slice(0, 2).map(part => part[0]).join('')}</span>}</span><strong>{person.name}</strong><small>{person.character || 'Cast'}</small></a>;
            })}</div> : <p class="quiet-empty">Cast information is not available yet.</p>}
            {data.cast.length > 0 && <details class="full-credits"><summary>Full cast & crew</summary><ul>{data.cast.map(person => <li><a href={`/cast/${encodeURIComponent(person.slug)}/`}>{person.name}</a><span>{person.role === 'cast' ? person.character || 'Cast' : person.role === 'director' ? 'Director' : 'Creator'}</span></li>)}</ul></details>}
          </section>
          {title.trailer_key && <section class="catalogue-section" aria-labelledby="trailer-title" data-detail-section="trailer"><h2 id="trailer-title">Trailer</h2>
            <a class="trailer-card" href={trailerUrl} aria-label={`Watch the ${title.title} trailer`}>{facadeImage && <img data-lazy-src={facadeImage} width="300" height="169" loading="lazy" decoding="async" alt="" />}<span class="trailer-shade" aria-hidden="true"></span><span class="trailer-play" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z"/></svg></span><span class="trailer-label">Watch the trailer</span></a></section>}
          <AdStack pageType="detail" placement="infeed" />
          {boxOffice && <section class="catalogue-section" aria-labelledby="boxoffice-title" data-detail-section="boxoffice"><h2 id="boxoffice-title">Box Office</h2><dl class="fact-rows">
            {title.budget !== null && title.budget > 0 && <div><dt>Budget (USD)</dt><dd>{currency(title.budget)}</dd></div>}
            {title.revenue !== null && title.revenue > 0 && <div><dt>Revenue (USD)</dt><dd>{currency(title.revenue)}</dd></div>}</dl></section>}
          <VerdictWidget votes={data.votes} titleId={title.id} titleType={title.type} />
          <AdStack pageType="detail" placement="native" />
          {title.type === 'tv' && <section class="catalogue-section" aria-labelledby="seasons-title" data-detail-section="seasons"><h2 id="seasons-title">Seasons</h2>{data.seasons.length > 0 ? <ul class="season-links">{data.seasons.map(season => <li><a href={`/tv/${encodeURIComponent(title.slug)}/season/${season.season_number}/`}><strong>{season.name || `Season ${season.season_number}`}</strong><span>{season.episode_count} episodes</span><small>{formatDate(season.air_date)}</small><span aria-hidden="true">→</span></a></li>)}</ul> : <p class="quiet-empty">Season information is not available yet.</p>}</section>}
          <section class="catalogue-section" aria-labelledby="gallery-title" data-detail-section="gallery"><h2 id="gallery-title">Gallery</h2>{gallery.length > 0 ? <div class="gallery-grid">{gallery.map((image, index) => <><img data-lazy-src={image} width="300" height="169" loading="lazy" decoding="async" alt={`${title.title} gallery image ${index + 1}`} /><noscript><img src={image} width="300" height="169" loading="lazy" decoding="async" alt={`${title.title} gallery image ${index + 1}`} /></noscript></>)}</div> : <p class="quiet-empty">No gallery images are available yet.</p>}</section>
          <section class="catalogue-section" aria-labelledby="questions-title"><h2 id="questions-title">Questions & answers</h2>{originality.questions.map(item => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</section>
          <AdStack pageType="detail" placement="lower_300x250" />
          <section class="catalogue-section" aria-labelledby="similar-title" data-detail-section="similar"><h2 id="similar-title">More Like This</h2>{data.similar.length > 0 ? <div class="poster-grid">{data.similar.map(similar => <PosterCard title={similar} mediaBase={mediaBase} />)}</div> : <p class="quiet-empty">Similar titles will appear as the catalogue grows.</p>}</section>
        </div>
        <aside class="detail-side">
          <section class="side-block" aria-labelledby="details-title" data-detail-section="information"><h2 id="details-title">Details</h2><dl class="fact-rows">
            <div><dt>Type</dt><dd>{kind}</dd></div><div><dt>Language</dt><dd>{language}</dd></div><div><dt>Release date</dt><dd>{formatDate(title.release_date)}</dd></div><div><dt>{title.type === 'tv' ? 'Network / studio' : 'Studio'}</dt><dd>{title.studio || 'Not listed'}</dd></div>
            {title.original_title && title.original_title !== title.title && <div><dt>Original title</dt><dd>{title.original_title}</dd></div>}
            {title.status && <div><dt>Status</dt><dd>{title.status}</dd></div>}</dl>
            <p class="title-originality">{originality.facts}</p>
            {originality.updated && <p class="poster-meta">Updated <time datetime={originality.updated}>{formatDate(originality.updated)}</time></p>}
          </section>
        </aside>
      </div>
    </article>}
</Base>
